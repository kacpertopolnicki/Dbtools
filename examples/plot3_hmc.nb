Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"iter", "[", 
     RowBox[{"{", 
      RowBox[{"x_", " ", ",", " ", "u_"}], "}"}], "]"}], ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"newx", " ", ",", " ", "newu", " ", ",", " ", "acc"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"newx", " ", ",", " ", "newu"}], "}"}], " ", "=", " ", 
        RowBox[{"link", "[", 
         RowBox[{"x", " ", "+", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.1"}], " ", ",", " ", "0.1"}], "}"}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"acc", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"1.0", " ", ",", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"u", " ", "-", " ", "newu"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], " ", "<=", " ", "acc"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"newx", " ", ",", " ", "newu"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", " ", ",", " ", "u"}], "}"}]}], "\[IndentingNewLine]", 
