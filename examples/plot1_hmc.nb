       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"newx", " ", ",", " ", "newu"}], "}"}], " ", "=", " ", 
        RowBox[{"link", "[", 
         RowBox[{"x", " ", "+", " ", 
          RowBox[{"RandomReal", "[", 
