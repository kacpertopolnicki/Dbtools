       RowBox[{"acc", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"1.0", " ", ",", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"u", " ", "-", " ", "newu"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
